{
  "name": "@oakestra/dashboard-sdk",
  "version": "0.1.0",
  "description": "Public contract between the Oakestra dashboard shell and addon UIs",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./federation": "./src/federation.ts",
    "./testing": "./src/testing.tsx",
    "./vite": "./src/vite.ts",
    "./vite/client": "./vite-client.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vite-client.d.ts"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./federation": {
        "types": "./dist/federation.d.ts",
        "default": "./dist/federation.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./vite/client": "./vite-client.d.ts",
      "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@module-federation/vite": "^1.23.7",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/react": "^16.0.0",
    "react": "^19.0.0",
    "react-router": "^8.0.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.7",
    "@oakestra/tsconfig": "workspace:*",
    "@tanstack/react-query": "^5.105.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tsdown": "^0.23.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@oakestra/api": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@module-federation/vite": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
