{
  "name": "@oakestra/ui",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oakestra/dashboard-v2.git",
    "directory": "packages/ui"
  },
  "description": "Oakestra dashboard design system: shadcn components and Tailwind v4 theme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./chart": "./src/chart.ts",
    "./data-table": "./src/data-table.ts",
    "./command": "./src/command.ts",
    "./map": "./src/map.ts",
    "./location-map": "./src/location-map.ts",
    "./styles.css": "./src/styles/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./chart": {
        "types": "./dist/chart.d.ts",
        "default": "./dist/chart.js"
      },
      "./data-table": {
        "types": "./dist/data-table.d.ts",
        "default": "./dist/data-table.js"
      },
      "./command": {
        "types": "./dist/command.d.ts",
        "default": "./dist/command.js"
      },
      "./map": {
        "types": "./dist/map.d.ts",
        "default": "./dist/map.js"
      },
      "./location-map": {
        "types": "./dist/location-map.d.ts",
        "default": "./dist/location-map.js"
      },
      "./styles.css": "./dist/styles/styles.css",
      "./theme.css": "./dist/styles/theme.css",
      "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "@types/geojson": "^7946.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.69.0",
    "maplibre-gl": "^6.16.0",
    "radix-ui": "^1.8.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@oakestra/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
