{
  "extends": "@oakestra/tsconfig/base.json",
  "compilerOptions": {
    // The published declarations are emitted with this config (tsdown). Without it TypeScript 6
    // prints inferred unions in the order it happened to create their members, which differs
    // between runs and would make the committed API reports flap.
    "stableTypeOrdering": true,
    // Fetch, Request and friends; no React and no DOM-only APIs beyond those.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // Node runs these sources directly (mock server, gen script), so only erasable syntax.
    "erasableSyntaxOnly": true
  },
  "include": ["src", "scripts", "vitest.config.ts", "tsdown.config.ts"]
}
