{
  "name": "@oakestra/api",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oakestra/dashboard-v2.git",
    "directory": "packages/api"
  },
  "description": "Typed client for the Oakestra system-manager API: generated paths, Zod models and endpoint functions",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "gen": "node scripts/gen-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "semver": "^7.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oakestra/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "openapi-typescript": "^7.13.0",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
