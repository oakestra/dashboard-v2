{
  "name": "oakestra-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @oakestra/shell dev",
    "dev:mock": "pnpm --filter @oakestra/shell dev:mock",
    "storybook": "pnpm --filter @oakestra/ui storybook",
    "build": "pnpm -r --filter=!@oakestra/e2e build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @oakestra/e2e e2e",
    "gen:api": "pnpm --filter @oakestra/api gen",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oakestra/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
